{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    // 模块级 AbilityStage：只为拿 onMemoryLevel（系统回收前优雅断开会话，P1/§7.5）
    "srcEntry": "./ets/entryabilitystage/EntryAbilityStage.ets",
    "deviceTypes": [
      "phone",
      "tablet",
      // 多窗口：PC/2in1 上主机列表与多个终端窗口并排（TerminalWindowAbility）
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        // SSH（原始 TCP）与同步 API（HTTP）都依赖此权限（DESIGN §7.6）
        "name": "ohos.permission.INTERNET"
      },
      {
        // 同步网络恢复触发（S6）与切网收敛（P1，@ohos.net.connection）
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        // 后台保活长时任务（P1，§7.5：切后台后维持 SSH 会话；用户可在设置中关闭）
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        // 触感反馈（DESIGN §4.4：粘滞键切换/复制成功等轻震，T7/T8）
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:reason_vibrate",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "TerminalWindowAbility"
          ],
          "when": "inuse"
        }
      },
      {
        // 读取系统剪贴板（DESIGN §4.4「粘贴」，T8：粘贴前读取并做多行确认）
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:reason_read_pasteboard",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "TerminalWindowAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        // P1：dataTransfer 长时任务（SSH 会话本身就是数据传输通道）。
        // 注意系统会对低速的 dataTransfer 任务挂起/取消，降级链见 service/background/
        "backgroundModes": [
          "dataTransfer"
        ],
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      },
      {
        // 多窗口方案 A：独立终端窗口。specified 实例由 EntryAbilityStage.onAcceptWant 分配
        // （`new:<uuid>` 新开 / `session:<id>` 复用）；只由本应用拉起，不上桌面
        "name": "TerminalWindowAbility",
        "srcEntry": "./ets/terminalwindowability/TerminalWindowAbility.ets",
        "description": "$string:TerminalWindowAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:TerminalWindowAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "launchType": "specified",
        "exported": false,
        // 关窗即移出最近任务（会话已转后台，可从主机列表恢复）
        "removeMissionAfterTerminate": true,
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        // 单位 vp：终端至少容得下约 40 列 × 10 行与顶栏 / 键条
        "minWindowWidth": 360,
        "minWindowHeight": 320,
        // 后台保活长时任务可能移交到本窗口（主窗口先关时），需同样声明 dataTransfer
        "backgroundModes": [
          "dataTransfer"
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}